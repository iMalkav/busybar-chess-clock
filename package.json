{
  "name": "chess-clock",
  "private": true,
  "version": "0.2.0",
  "description": "Two-player chess clock for BUSY Bar",
  "author": "iMalkav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iMalkav/busybar-chess-clock.git"
  },
  "homepage": "https://github.com/iMalkav/busybar-chess-clock#readme",
  "bugs": {
    "url": "https://github.com/iMalkav/busybar-chess-clock/issues"
  },
  "license": "MIT",
  "keywords": ["busy-bar", "chess", "chess-clock", "javascript-app"],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "node --test tests/clock.test.ts tests/input.test.ts tests/visuals.test.ts tests/metadata.test.mjs",
    "metadata": "node scripts/metadata.mjs",
    "build": "node scripts/prepare-resources.mjs && busy-cli build --emit both --bundle",
    "smoke": "node tests/bundle-smoke.mjs",
    "check": "pnpm metadata && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "release": "pnpm check && node scripts/release.mjs",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@busy-app/cli": "0.6.0",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@busy-app/busy-lib": "0.21.1"
  }
}
